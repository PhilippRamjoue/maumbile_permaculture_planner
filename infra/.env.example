# Copy to .env and adjust. Never commit the real .env.

# --- Database (shared by db + backend) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=permaculture

# --- Backend (APP_* maps to app.core.config.Settings) ---
APP_ENVIRONMENT=production
APP_DEBUG=false
# Must match the db credentials above; host is the compose service name "db".
APP_DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/permaculture
# CORS origins as a JSON array (optional override):
# APP_CORS_ORIGINS=["http://localhost:8080"]

# --- Scale-up only (docker-compose.scale.yml) ---
# APP_REDIS_URL=redis://redis:6379/0
