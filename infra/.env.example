# Copy to infra/.env for local use; on Coolify set the same names under the resource's
# "Environment Variables". Never commit the real .env.
# Variables marked REQUIRED make `docker compose` refuse to start when unset.

# --- Database (shared by db + backend) -------------------------------------------------------
POSTGRES_USER=postgres
# REQUIRED. Keep it URL-safe (letters/digits): it is embedded in the backend's database URL.
# Generate: openssl rand -hex 24
# NOTE: Postgres reads this only when it first initialises an empty volume; changing it later
# does not change the stored password (see docs/DEPLOY.md, "Rotating secrets").
POSTGRES_PASSWORD=change-me
POSTGRES_DB=permaculture

# --- Backend (APP_* maps to app.core.config.Settings) ----------------------------------------
# REQUIRED. JWT signing secret; the backend refuses to boot in production with the dev default.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs every user out (tokens stop validating) but loses no data.
APP_SECRET_KEY=change-me

# Secure flag on auth cookies. Keep true behind HTTPS (Coolify's proxy terminates TLS). Only
# docker-compose.local.yml turns it off, for plain-http localhost.
APP_COOKIE_SECURE=true

# CORS origins as a JSON array. The SPA calls /api same-origin through its nginx, so the default
# [] works; set it to the public origin(s) of the deployment, e.g. ["https://planner.example.org"].
APP_CORS_ORIGINS=["https://planner.example.org"]

# Optional: JSON console logs -> human-readable console renderer + SQL echo. Leave false in prod.
# APP_DEBUG=false

# Optional: login attempts per client IP and per email per minute (default 10). Only throwaway test
# stacks need more.
# APP_LOGIN_RATE_LIMIT_ATTEMPTS=10

# Optional: default vertical spacing of terrain contour lines in metres (callers may override).
# APP_TERRAIN_CONTOUR_INTERVAL_M=5.0

# --- Not configurable via env ----------------------------------------------------------------
# Imagery/elevation providers per country live in backend/app/modules/regions/seed.py (data in
# code, changed by a commit + redeploy). No provider needs an API key.

# --- Scale-up only (docker-compose.scale.yml) ------------------------------------------------
# APP_REDIS_URL=redis://redis:6379/0
